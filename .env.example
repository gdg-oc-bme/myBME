SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=mybme
DB_USER=mybme
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SAML SP (eduID login via https://login.bme.hu/) — base URL this backend
# is reachable at; must match the entityid/ACS URL registered with BME.
SAML_SP_BASE_URL=http://localhost:8000
# "xmlsec1" needs `apt install xmlsec1`; only override to "XMLSecurity"
# (pure-Python, untested by pysaml2, no encrypted-assertion support) in a
# sandbox where that isn't possible.
SAML_CRYPTO_BACKEND=xmlsec1

# Linked services shown on the dashboard. Fill in with real URLs.
MOODLE_URL=
NEPTUN_URL=
